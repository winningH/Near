# 数据库配置（SQLite，路径相对于 prisma/schema.prisma 所在目录）
DATABASE_URL="file:./dev.db"

# OpenAI 兼容接口配置
# 适用于 OpenAI 官方，以及任何 OpenAI 兼容服务（DeepSeek、Moonshot、通义、本地 Ollama/vLLM 等）
# 切换服务商只需替换下面三行
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 深度思考使用的模型，留空则关闭深度思考功能
OPENAI_THINKING_MODEL=

# 部分服务商通过请求参数开启思考，JSON 对象形式：
# OPENAI_THINKING_PARAMS={"enable_thinking":true}
# OPENAI_THINKING_PARAMS={"reasoning_effort":"high"}

# 应用配置
APP_NAME=Near
PORT=3001

# 安全配置（可选）
# 允许访问的前端来源，多个用英文逗号分隔；留空则允许所有来源
CORS_ORIGIN=http://localhost:3000

# 是否把图片以 base64 送入多模态模型；纯文本模型请设为 false
ENABLE_VISION=true
