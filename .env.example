# 数据库配置（SQLite，路径相对于 prisma/schema.prisma 所在目录）
DATABASE_URL="file:./dev.db"

# ============================================================================
# OpenAI 兼容接口配置
# 下面三项【均为必填】。缺失时服务启动会明确打印缺少哪些变量，
# 且不会发起任何 AI 请求（不存在任何内置默认值）。
#
# 适用任何 OpenAI 兼容服务：OpenAI / DeepSeek / 智谱 / Moonshot / 通义 /
# LongCat / 本地 Ollama、vLLM 等，换服务商只需改这三项。
# ============================================================================

OPENAI_API_KEY=your_api_key_here

# 接口地址，末尾写不写 /v1 都可以，程序会自动补全
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   智谱         https://open.bigmodel.cn/api/paas/v4
#   Moonshot    https://api.moonshot.cn/v1
#   LongCat     https://api.longcat.chat/openai
#   本地 Ollama  http://localhost:11434/v1
OPENAI_API_BASE=https://api.openai.com/v1

# 模型名称，需与上面的接口地址所属服务商对应
#   例：gpt-4o-mini / deepseek-chat / glm-4-flash / moonshot-v1-8k / qwen2.5:7b
OPENAI_MODEL=gpt-4o-mini

# 深度思考使用的模型，留空则关闭深度思考功能（前端开关会同时失效）
OPENAI_THINKING_MODEL=

# 深度思考通过请求参数控制（仅当 OPENAI_THINKING_MODEL 非空时生效）。
# 不同服务商的 thinking 参数差异巨大，必须传【对象】而非 boolean：
#   智谱 GLM-4.5   {"thinking":{"type":"disabled"}}  ← 默认思考 ON，要关闭必须显式传
#   DeepSeek-R1    {"thinking":{"type":"disabled"}}
#   通义 qwen3      {"enable_thinking":false}
#   OpenAI o 系列   {"reasoning_effort":"low"} 或不传
# 不填则用空对象（不影响默认行为）
OPENAI_THINKING_OFF_PARAMS={"thinking":{"type":"disabled"}}

# 部分服务商需要显式开启思考时才传（可选，留空表示不传）：
#   OPENAI_THINKING_PARAMS={"thinking":{"type":"enabled"}}
#   OPENAI_THINKING_PARAMS={"enable_thinking":true}
#   OPENAI_THINKING_PARAMS={"reasoning_effort":"high"}

# 部分服务商通过请求参数而非独立模型开启思考，JSON 对象形式：
#   OPENAI_THINKING_PARAMS={"enable_thinking":true}
#   OPENAI_THINKING_PARAMS={"reasoning_effort":"high"}

# 采样温度（可选，默认 0.7）
OPENAI_TEMPERATURE=0.7

# 应用配置
PORT=3001

# 安全配置（可选）
# 允许访问的前端来源，多个用英文逗号分隔；留空则允许所有来源
# 前端默认 3000；若被占用 vue-cli 会自动换端口（如 3002），按实际访问端口配置
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# 是否把图片以 base64 送入多模态模型；纯文本模型请设为 false
ENABLE_VISION=true

# 上传配置（可选）
# 孤儿附件保留时长（小时）：已上传但从未随消息发送、且超过该时长的文件会被定期清理。
# 保留期内的文件视为仍在输入区编辑中，不会被删除。默认 24
UPLOAD_RETENTION_HOURS=24
